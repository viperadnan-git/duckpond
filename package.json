{
	"name": "duckpond",
	"private": true,
	"version": "1.0.0",
	"description": "Duck Address generator and alias manager for DuckDuckGo Email Protection. Runs entirely in the browser.",
	"keywords": [
		"duckduckgo",
		"duck address",
		"email alias",
		"email protection",
		"privacy",
		"sveltekit"
	],
	"homepage": "https://duck.viperadnan.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/viperadnan-git/duckpond.git"
	},
	"bugs": {
		"url": "https://github.com/viperadnan-git/duckpond/issues"
	},
	"license": "MIT",
	"author": "Adnan Ahmad (https://viperadnan.com)",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest --run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"assets": "sh scripts/assets.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/caveat": "^5.3.0",
		"@fontsource-variable/martian-mono": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"bits-ui": "^2.19.5",
		"cn": "^0.5.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.3.4",
		"vitest": "^4.1.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"tldts": "^7.4.18",
		"zod": "^4.6.7"
	}
}
